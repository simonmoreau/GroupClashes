<Project Sdk="Microsoft.NET.Sdk">

	<Import Project=".\..\CommonAssemblyInfo.props" />

	<PropertyGroup>
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<OutputType>Library</OutputType>
		<UseWindowsForms>true</UseWindowsForms>
		<UseWPF>true</UseWPF>
		<ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
		<!-- Create the configuration to build various versions of Navisworks -->
		<Configurations>Debug;2020;2021;2022;2023;2024;2025;2026;2027</Configurations>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Platforms>x64</Platforms>
		<NuGetAudit>false</NuGetAudit>
		<BuildInParallel>false</BuildInParallel>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<AssemblyName>GroupClashes.BM42</AssemblyName>
		<RootNamespace>GroupClashes</RootNamespace>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<NoWarn>MSB3052</NoWarn>
	</PropertyGroup>

	<!-- If the configuration is a Navisworks version,
       we use this configuration as a variable
       for the rest of the csproj -->
	<PropertyGroup Condition="!$(Configuration.Contains('Debug'))">
		<VersionSoftware>$(Configuration)</VersionSoftware>
	</PropertyGroup>

	<!-- Debug -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<!-- We can only debug just ONE addin version.
         Instead of building all versions above,
         we just put ONE version below and switch to 'Debug' configuration  -->
		<VersionSoftware>2027</VersionSoftware>
		<StartAction>Program</StartAction>
		<StartProgram>$(ProgramW6432)\Autodesk\Navisworks Manage $(VersionSoftware)\Roamer.exe</StartProgram>
	</PropertyGroup>

	<!-- Release -->
	<PropertyGroup Condition="!$(Configuration.Contains('Debug'))">
		<Optimize>true</Optimize>
		<OutputPath>bin\$(VersionSoftware)\</OutputPath>
		<DefineConstants>VERSION$(VersionSoftware)</DefineConstants>
		<DebugType>None</DebugType>
	</PropertyGroup>

	<!-- Debug -->
	<PropertyGroup Condition="$(Configuration.Contains('Debug'))">
		<DebugSymbols>true</DebugSymbols>
		<OutputPath>bin\Debug\</OutputPath>
		<DefineConstants>DEBUG;TRACE;VERSION$(VersionSoftware)</DefineConstants>
		<DebugType>Full</DebugType>
	</PropertyGroup>

	<PropertyGroup>
		<NavisworksNugetVersion>$(VersionSoftware).*</NavisworksNugetVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Get the Autodesk.Navisworks.Api.dll, Autodesk.Navisworks.Clash.dll, ... -->
		<PackageReference Include="Speckle.Navisworks.API" Version="$(NavisworksNugetVersion)" IncludeAssets="build; compile" PrivateAssets="All" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="PresentationCore" />
		<Reference Include="PresentationFramework" />
		<Reference Include="System.Windows" />
		<Reference Include="System.Xaml" />
		<Reference Include="System.Xml.Linq" />
		<Reference Include="System.Data.DataSetExtensions" />
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="UIAutomationProvider" />
		<Reference Include="WindowsBase" />
		<Reference Include="WindowsFormsIntegration" />
	</ItemGroup>

	<ItemGroup>
		<Page Remove="en-US\GroupClashes.xaml" />
	</ItemGroup>

	<ItemGroup>
		<None Include="en-US\GroupClashes.name">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Include="en-US\GroupClashes.xaml">
			<Generator>XamlIntelliSenseFileGenerator</Generator>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Images\GroupClashesIcon_Large.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="Images\GroupClashesIcon_Small.ico">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
		<None Update="PackageContents.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="powershell -ExecutionPolicy Unrestricted $(ProjectDir)PostBuild.ps1 -VersionSoftware $(VersionSoftware) -TargetName $(TargetName) -ProjectDir $(ProjectDir) -TargetPath $(TargetPath) -TargetDir $(TargetDir) -Configuration $(Configuration)" />
	</Target>

</Project>
